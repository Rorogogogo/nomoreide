{
  "fixtureVersion": 2,
  "comment": "Ordered MCP calls for the Phase 3 git surface. Each runtime gets a private home and its own copy of every repository below, so the two runs are equivalent but share nothing. Every commit is stamped with one fixed timestamp, which is what makes the hashes comparable. Steps grow as each git slice lands.",
  "repositories": [
    {
      "id": "demo",
      "initialBranch": "main",
      "comment": "Ends up two commits ahead of its upstream and one behind \u2014 different numbers, so a swapped column shows \u2014 with a staged file, an unstaged edit, a deletion, and an untracked path that needs quoting.",
      "setup": [
        {
          "commit": {
            "file": "README.md",
            "contents": "demo\n",
            "message": "initial commit"
          }
        },
        {
          "commit": {
            "file": "keep.txt",
            "contents": "one\ntwo\nthree\n",
            "message": "add keep"
          }
        },
        {
          "commit": {
            "file": "extra.txt",
            "contents": "extra\n",
            "message": "add extra"
          }
        },
        {
          "remote": true
        },
        {
          "remoteHead": "main"
        },
        {
          "resetTo": "HEAD~1"
        },
        {
          "commit": {
            "file": "ahead.txt",
            "contents": "a\n",
            "message": "diverge from origin"
          }
        },
        {
          "commit": {
            "file": "ahead-again.txt",
            "contents": "b\n",
            "message": "diverge further"
          }
        },
        {
          "branch": "feature/x"
        },
        {
          "write": {
            "keep.txt": "one\ntwo\nthree\nfour\n",
            "staged.txt": "staged\n",
            "untracked file.txt": "u\n"
          }
        },
        {
          "remove": [
            "README.md"
          ]
        },
        {
          "stage": [
            "staged.txt"
          ]
        }
      ]
    },
    {
      "id": "second",
      "initialBranch": "trunk",
      "comment": "No remote, so its status has no upstream key at all.",
      "setup": [
        {
          "commit": {
            "file": "main.py",
            "contents": "print(1)\n",
            "message": "add main"
          }
        }
      ]
    },
    {
      "id": "writes",
      "initialBranch": "main",
      "comment": "Untouched by the read steps, so the staging and committing steps below start from a state they fully describe.",
      "setup": [
        {
          "commit": {
            "file": "kept.txt",
            "contents": "one\n",
            "message": "initial commit"
          }
        },
        {
          "remote": true
        },
        {
          "branch": "existing"
        },
        {
          "write": {
            "kept.txt": "one\ntwo\n",
            "added.txt": "new\n"
          }
        }
      ]
    },
    {
      "id": "unborn",
      "initialBranch": "main",
      "comment": "Initialized and never committed to: a branch that exists by name only.",
      "setup": []
    },
    {
      "id": "detached",
      "initialBranch": "main",
      "comment": "HEAD on no branch, which is a branch named nothing rather than a branch named HEAD.",
      "setup": [
        {
          "commit": {
            "file": "a.txt",
            "contents": "a\n",
            "message": "only commit"
          }
        },
        {
          "detach": true
        }
      ]
    },
    {
      "id": "pushes",
      "initialBranch": "main",
      "setup": [
        {
          "commit": {
            "file": "a.txt",
            "contents": "a\n",
            "message": "initial commit"
          }
        },
        {
          "remote": true
        },
        {
          "commit": {
            "file": "b.txt",
            "contents": "b\n",
            "message": "second commit"
          }
        },
        {
          "branch": "feature"
        }
      ]
    }
  ],
  "plainDirectories": [
    "not-a-repo"
  ],
