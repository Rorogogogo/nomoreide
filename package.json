    "context-parity": "node --import tsx scripts/check-context-parity.ts",
    "shell-parity": "node --import tsx scripts/check-shell-parity.ts",
    "servers-parity": "node --import tsx scripts/check-servers-parity.ts",
    "docker-parity": "node --import tsx scripts/check-docker-parity.ts",
    "agent-status-parity": "node --import tsx scripts/check-agent-status-parity.ts",
    "usage-parity": "node --import tsx scripts/check-usage-parity.ts",
    "agent-info-parity": "node --import tsx scripts/check-agent-info-parity.ts",
    "extensions-parity": "node --import tsx scripts/check-extensions-parity.ts",
    "skills-parity": "node --import tsx scripts/check-skills-parity.ts",
    "dashboard-parity": "node --import tsx scripts/check-dashboard-parity.ts",
    "metrics-parity": "node --import tsx scripts/check-metrics-parity.ts",
    "errors-bundle-parity": "node --import tsx scripts/check-errors-bundle-parity.ts",
    "streams-parity": "node --import tsx scripts/check-streams-parity.ts",
    "terminal-streams-parity": "node --import tsx scripts/check-terminal-streams-parity.ts",
    "service-test-parity": "node --import tsx scripts/check-service-test-parity.ts",
    "jetbrains-parity": "node --import tsx scripts/check-jetbrains-parity.ts",
    "agent-auth-parity": "node --import tsx scripts/check-agent-auth-parity.ts",
    "agent-registry-parity": "node --import tsx scripts/check-agent-registry-parity.ts",
    "agent-chat-parity": "node --import tsx scripts/check-agent-chat-parity.ts",
    "onboard-stream-parity": "node --import tsx scripts/check-onboard-stream-parity.ts",
    "service-inspector-parity": "node --import tsx scripts/check-service-inspector-parity.ts",
    "parity": "node --import tsx scripts/run-parity-gates.ts",
    "no-node-check": "bash scripts/check-no-node.sh",
    "install-check": "bash scripts/check-install.sh",
    "mcp:service-parity": "node --import tsx scripts/check-mcp-service-parity.ts",
    "mcp:runtime-parity": "node --import tsx scripts/check-mcp-runtime-parity.ts",
    "test": "vitest run",
    "tauri": "tauri",
    "rust:dependency-check": "node scripts/check-rust-dependencies.mjs",
    "tauri:dev": "tauri dev --config crates/nomoreide-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config crates/nomoreide-tauri/tauri.conf.json",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "video:render": "npm --prefix video run render",
    "video:still": "npm --prefix video run still",
    "video:studio": "npm --prefix video run studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.19",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.10.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
