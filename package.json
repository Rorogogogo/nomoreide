{
  "name": "nomoreide",
  "version": "0.1.103",
  "description": "An AI-native terminal workbench for services, Git review, logs, and MCP workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rorogogogo/nomoreide.git"
  },
  "homepage": "https://github.com/Rorogogogo/nomoreide#readme",
  "bugs": {
    "url": "https://github.com/Rorogogogo/nomoreide/issues"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "ai",
    "terminal",
    "mcp",
    "git",
    "developer-tools"
  ],
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "apps/website"
  ],
  "bin": {
    "nomoreide": "dist/index.js"
  },
  "files": [
    "dist",
    "profiles/nomoreide-debug",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build --workspace @nomoreide/dashboard && tsc -p tsconfig.json",
    "lint": "biome lint src apps/dashboard/src",
    "lint:fix": "biome lint --write src apps/dashboard/src",
    "dev": "tsx src/index.ts",
    "dev:web": "npm run dev --workspace @nomoreide/dashboard",
    "mcp:contract:update": "node --import tsx scripts/update-mcp-contract.ts",
    "mcp:git-parity": "node --import tsx scripts/check-mcp-git-parity.ts",
    "mcp:github-parity": "node --import tsx scripts/check-mcp-github-parity.ts",
    "git-actions-parity": "node --import tsx scripts/check-git-actions-parity.ts",
    "host-parity": "node --import tsx scripts/check-host-parity.ts",
    "mcp:onboard-parity": "node --import tsx scripts/check-mcp-onboard-parity.ts",
    "mcp:database-parity": "node --import tsx scripts/check-mcp-database-parity.ts",
    "mcp:deploy-parity": "node --import tsx scripts/check-mcp-deploy-parity.ts",
    "mcp:docs-ui-parity": "node --import tsx scripts/check-mcp-docs-ui-parity.ts",
    "mcp:errors-parity": "node --import tsx scripts/check-mcp-errors-parity.ts",
    "mcp:agent-env-parity": "node --import tsx scripts/check-mcp-agent-env-parity.ts",
    "mcp:profiles-parity": "node --import tsx scripts/check-mcp-profiles-parity.ts",
    "mcp:registry-parity": "node --import tsx scripts/check-mcp-registry-parity.ts",
    "mcp:terminal-parity": "node --import tsx scripts/check-mcp-terminal-parity.ts",
    "approval-parity": "node --import tsx scripts/check-approval-parity.ts",
    "git-reads-parity": "node --import tsx scripts/check-git-reads-parity.ts",
    "git-writes-parity": "node --import tsx scripts/check-git-writes-parity.ts",
    "git-remote-parity": "node --import tsx scripts/check-git-remote-parity.ts",
    "git-worktrees-parity": "node --import tsx scripts/check-git-worktrees-parity.ts",
    "git-repositories-parity": "node --import tsx scripts/check-git-repositories-parity.ts",
    "github-connection-parity": "node --import tsx scripts/check-github-connection-parity.ts",
    "github-api-parity": "node --import tsx scripts/check-github-api-parity.ts",
    "github-template-parity": "node --import tsx scripts/check-github-template-parity.ts",
    "database-connections-parity": "node --import tsx scripts/check-database-connections-parity.ts",
    "database-catalog-parity": "node --import tsx scripts/check-database-catalog-parity.ts",
    "database-writes-parity": "node --import tsx scripts/check-database-writes-parity.ts",
    "database-export-parity": "node --import tsx scripts/check-database-export-parity.ts",
    "git-branch-parity": "node --import tsx scripts/check-git-branch-parity.ts",
    "service-config-parity": "node --import tsx scripts/check-service-config-parity.ts",
    "service-files-parity": "node --import tsx scripts/check-service-files-parity.ts",
    "service-register-parity": "node --import tsx scripts/check-service-register-parity.ts",
    "settings-parity": "node --import tsx scripts/check-settings-parity.ts",
    "workflows-parity": "node --import tsx scripts/check-workflows-parity.ts",
    "log-sources-parity": "node --import tsx scripts/check-log-sources-parity.ts",
    "fs-directories-parity": "node --import tsx scripts/check-fs-directories-parity.ts",
    "onboard-parity": "node --import tsx scripts/check-onboard-parity.ts",
    "snapshots-parity": "node --import tsx scripts/check-snapshots-parity.ts",
    "workflow-triggers-parity": "node --import tsx scripts/check-workflow-triggers-parity.ts",
    "terminal-parity": "node --import tsx scripts/check-terminal-parity.ts",
    "change-sets-parity": "node --import tsx scripts/check-change-sets-parity.ts",
    "agent-env-parity": "node --import tsx scripts/check-agent-env-parity.ts",
    "agent-profiles-parity": "node --import tsx scripts/check-agent-profiles-parity.ts",
    "context-parity": "node --import tsx scripts/check-context-parity.ts",
    "shell-parity": "node --import tsx scripts/check-shell-parity.ts",
    "mcp:parity": "node --import tsx scripts/check-mcp-parity.ts --",
    "mcp:service-parity": "node --import tsx scripts/check-mcp-service-parity.ts",
    "mcp:runtime-parity": "node --import tsx scripts/check-mcp-runtime-parity.ts",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "tauri": "tauri",
    "rust:dependency-check": "node scripts/check-rust-dependencies.mjs",
    "tauri:dev": "tauri dev --config crates/nomoreide-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config crates/nomoreide-tauri/tauri.conf.json",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "video:render": "npm --prefix video run render",
    "video:still": "npm --prefix video run still",
    "video:studio": "npm --prefix video run studio"
  },
  "dependencies": {
    "fastmcp": "^3.0.0",
    "js-yaml": "^4.1.1",
    "mysql2": "^3.22.3",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.19",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.10.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
