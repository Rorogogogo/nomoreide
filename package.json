{
  "name": "nomoreide",
  "version": "0.1.94",
  "description": "An AI-native terminal workbench for services, Git review, logs, and MCP workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rorogogogo/nomoreide.git"
  },
  "homepage": "https://github.com/Rorogogogo/nomoreide#readme",
  "bugs": {
    "url": "https://github.com/Rorogogogo/nomoreide/issues"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "ai",
    "terminal",
    "mcp",
    "git",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "nomoreide": "dist/index.js"
  },
  "files": [
    "dist",
    "profiles/nomoreide-debug",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "dev": "tsx src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "video:render": "npm --prefix video run render",
    "video:still": "npm --prefix video run still",
    "video:studio": "npm --prefix video run studio"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "fastmcp": "^3.0.0",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "mysql2": "^3.22.3",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-icons": "^16.20.0",
    "smol-toml": "^1.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.3",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tauri-apps/cli": "^2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.19",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.10.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
